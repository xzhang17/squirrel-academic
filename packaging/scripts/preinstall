#!/bin/bash
# Check the destination before Installer writes the system payload.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
fail() { printf '%s\n' "$*" >&2; exit 1; }
[[ $3 == / ]] || fail 'Install on the currently running macOS startup disk.'
owner_uid=$(/usr/bin/stat -f %u /dev/console)
[[ $owner_uid -ge 500 ]] || fail 'Sign in to the Mac, then open this installer.'
/bin/launchctl print "gui/$owner_uid" >/dev/null || fail 'Open this installer from the signed-in desktop.'
target='/Library/Input Methods/Squirrel.app'
support='/Library/Application Support/Squirrel Academic'
for directory in '/Library/Input Methods' "$target" "$support" "$support/Setup"; do
  [[ ! -L "$directory" ]] || fail "Installer found a linked destination: $directory"
done
if [[ -e "$target" ]]; then
  info="$target/Contents/Info.plist"
  [[ -f "$info" ]] || fail 'A different item occupies the Squirrel installation path.'
  id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$info")
  [[ $id == im.rime.inputmethod.Squirrel ]] || fail 'A different app occupies the Squirrel installation path.'
  base=$(/usr/libexec/PlistBuddy -c 'Print :AcademicTypingBase' "$info" 2>/dev/null || true)
  binary="$target/Contents/MacOS/Squirrel"
  original=$(/usr/bin/shasum -a 256 "$binary")
  engine=$(/usr/bin/shasum -a 256 "$target/Contents/Frameworks/librime.1.dylib")
  [[ ${engine%% *} == 8de2bcbaa30a838d42f42987e9fb1345260f36c97aa7a20b6749970f46dcf6b8 ]] ||
    fail 'A different Squirrel engine is installed. This package accepts a new Mac or the d220b92 nightly.'
  [[ $base == d220b92 || ${original%% *} == 552a208e8c819591a627fe5e2726890e1e04c71e072395037aa7531388384a82 ]] ||
    fail 'A different Squirrel build is installed. This package accepts a new Mac or the d220b92 nightly.'
  if /usr/bin/pgrep -u "$owner_uid" -x Squirrel >/dev/null; then
    /bin/launchctl asuser "$owner_uid" /usr/bin/sudo -n -H -u "#$owner_uid" "$binary" --quit
    for attempt in {1..20}; do
      /usr/bin/pgrep -u "$owner_uid" -x Squirrel >/dev/null || break
      /bin/sleep 0.1
    done
    if /usr/bin/pgrep -u "$owner_uid" -x Squirrel >/dev/null; then
      fail 'Switch to another keyboard, quit Squirrel, and run the installer again.'
    fi
  fi
fi
